# Copy to `.env` and edit. Never commit the real .env file.
# Every value here is optional: the app runs fully with local datasets if the
# file does not exist.

# ---------- Database ----------
# MEDIGRAPH_DB=E:/path/to/medigraph.db

# ---------- Security ----------
# PBKDF2_ITERATIONS=240000
# SESSION_TIMEOUT_MIN=120

# ---------- Knowledge graph (Neo4j) ----------
# Without this, an in-process NetworkX graph is used and findings are identical.
# docker run -d --name medigraph-neo4j -p 7474:7474 -p 7687:7687 \
#   -e NEO4J_AUTH=neo4j/your_password neo4j:5
USE_NEO4J=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ---------- Medication identification (RxNorm / RxNav) ----------
# Free, no API key required. https://rxnav.nlm.nih.gov/
USE_RXNORM_API=false
RXNORM_BASE_URL=https://rxnav.nlm.nih.gov/REST

# ---------- Drug labels (openFDA) ----------
# Works without a key at a lower rate limit.
# Request one at https://open.fda.gov/apis/authentication/
USE_OPENFDA_API=false
OPENFDA_API_KEY=
OPENFDA_BASE_URL=https://api.fda.gov/drug/label.json
HTTP_TIMEOUT=8

# ---------- LLM for the chatbot ----------
# Leave as "none" to use extractive answers composed from retrieved passages.
# anthropic -> https://console.anthropic.com/
# openai    -> https://platform.openai.com/api-keys
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---------- OCR (scanned prescriptions) ----------
# Tesseract is found automatically on PATH or in the default install folder.
# Set this only if yours is somewhere else.
# Install: winget install UB-Mannheim.TesseractOCR
#          python -m pip install pytesseract pypdf
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Handwriting needs the vision-LLM engine, which uses the LLM keys above and is
# only used when you tick the consent box on the upload.

# ---------- NLP ----------
USE_SPACY=true
SPACY_MODEL=en_core_web_sm
